# Copy to backend/.env. Never put live credentials in tracked files.
DEBUG=true
# Required with DEBUG=false; generate with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Required for routing/geocoding. Missing key returns 503 not_configured.
TOMTOM_API_KEY=
# Optional paid Open-Meteo access; switches to customer-api.open-meteo.com.
OPEN_METEO_API_KEY=
# Defaults to backend/.cache; must be private, writable and shared by all gunicorn workers.
# Use a persistent disk path in production, e.g. /var/data/spotter-cache.
CACHE_DIR=.cache
# Gross truck routing weight = cargo load_lbs + this assumed tare, converted to integer kg.
TRUCK_TARE_LBS=35000
# Defaults to false in DEBUG and true in production. Disable only for local HTTP smoke tests.
SECURE_SSL_REDIRECT=false
# Render sets RENDER_EXTERNAL_HOSTNAME automatically; it is added to ALLOWED_HOSTS.
